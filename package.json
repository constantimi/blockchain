{
    "name": "blockchain",
    "version": "1.0.0",
    "description": "A TypeScript implementation of blockchain concepts including Proof of Work, Proof of Stake, and Liquidity Pools",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "ts-node --esm node_modules/mocha/bin/mocha.js tests/**/*.test.ts",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "example:pow": "npm run build && node dist/examples/pow-example.js",
        "example:pos": "npm run build && node dist/examples/pos-example.js",
        "example:liquidity": "npm run build && node dist/examples/liquidity-pool-example.js"
    },
    "keywords": [
        "blockchain",
        "typescript",
        "proof-of-work",
        "proof-of-stake",
        "liquidity-pool"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "chai": "^6.3.0",
        "eslint": "^10.14.0",
        "mocha": "^12.0.3",
        "prettier": "^3.9.10",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/constantimi/blockchain.git"
    },
    "bugs": {
        "url": "https://github.com/constantimi/blockchain/issues"
    },
    "homepage": "https://github.com/constantimi/blockchain#readme"
}
